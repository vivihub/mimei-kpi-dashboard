<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mimei.daily-update</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/shusuzuki/Documents/Claude/Projects/HDE重要KPI管理ダッシュボード/daily_update.sh</string>
